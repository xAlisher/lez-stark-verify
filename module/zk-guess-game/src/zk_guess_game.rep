// Qt Remote Objects contract for the ZK Guess game backend (EPIC A — rooms).
// PROPs auto-sync to QML; SIGNALs via Connections{target:backend}; SLOTs called directly.
// Room transport = a StationCrypto code→delivery content-topic; presence = announce/heartbeat/TTL.
class ZkGuessGame
{
    PROP(QString connectionStatus="idle" READONLY)   // idle|connecting|connected
    PROP(bool    nodeReady=false READONLY)
    PROP(QString roomCode="" READONLY)                // the invite code (creator shows it)
    PROP(QString roomName="" READONLY)
    PROP(bool    inRoom=false READONLY)
    PROP(bool    isCreator=false READONLY)
    PROP(QString myId="" READONLY)                    // my ephemeral player id
    PROP(QString suggestedName="" READONLY)           // 3 words derived from my id (prefill the name field)
    PROP(QString currentTurnId="" READONLY)           // whose move it is (turn order)
    PROP(QString currentTurnName="" READONLY)
    PROP(QString rosterJson="[]" READONLY)            // [{id,name,role,online}] TTL-pruned
    PROP(QString chatJson="[]" READONLY)              // [{id,name,text,ts}]
    PROP(bool    collectingEntropy=false READONLY)    // entropy phase: everyone draws before the seal
    PROP(bool    entropySubmitted=false READONLY)     // I've submitted my draw
    PROP(bool    started=false READONLY)              // game in the guess phase
    PROP(QString sealedCommitment="" READONLY)        // C = SHA256(secret‖blind), broadcast after entropy
    PROP(QString turnsJson="[]" READONLY)             // [{by,name,guess,dir,proven}]
    PROP(QString provingName="" READONLY)             // a guess is being proven now (per-turn STARK) → spinner
    PROP(int     provingGuess=-1 READONLY)            // the guess under proof (for the loader label)
    PROP(bool    won=false READONLY)
    PROP(QString winnerName="" READONLY)
    PROP(int     secretRevealed=-1 READONLY)          // the number, revealed on win
    PROP(bool    settling=false READONLY)             // win being settled on-zone (real STARK ~16min) → countdown
    PROP(double  settleStartMs=0 READONLY)            // when settlement proving began (countdown anchor)
    PROP(int     settleBlock=-1 READONLY)             // block the settlement landed in (done)
    PROP(QString settleTx="" READONLY)                // the on-zone tx hash (the settlement proof)
    PROP(QString settleError="" READONLY)             // settlement failure, if any
    PROP(QString lastError="" READONLY)

    // ── TOK pot (EPIC D) — bet TOK, the proven winner takes the pot (minus a fixed dev + host cut) ──
    PROP(int     betAmount=0 READONLY)                // this room's stake size in TOK (0 = free game)
    PROP(QString myOnZoneAddr="" READONLY)            // my on-zone pot account (funded from the faucet)
    PROP(bool    onZoneFunded=false READONLY)         // my pot account has TOK
    PROP(int     myBalance=0 READONLY)                // my pot-account balance (TOK)
    PROP(QString stakeState="none" READONLY)          // none|funding|staking|staked|refunding|refunded
    PROP(QString stakeTx="" READONLY)                 // my stake tx hash
    PROP(int     potTotal=0 READONLY)                 // sum of stakes seen this room
    PROP(bool    potReady=false READONLY)             // host created the on-zone pot → staking is open
    PROP(QString gameId="" READONLY)                  // host's on-zone game account (broadcast to stakers)
    PROP(int     builderBps=250 READONLY)             // fixed dev rake (2.5%) — display
    PROP(int     hostBps=500 READONLY)                // host cut (5%) — display
    PROP(QString payoutTx="" READONLY)                // the 3-way split settlement tx (== settleTx on a pot game)

    SIGNAL(activity(QString line))                    // human-readable log line

    SLOT(QString createRoom(QString roomName, QString displayName))   // → generates the code, hosts
    SLOT(QString joinRoom(QString code, QString displayName))          // → derive topic, subscribe, announce
    SLOT(QString sendChat(QString text))
    SLOT(QString startGame())                          // creator only; needs ≥2 players — opens the entropy phase
    SLOT(QString submitEntropy(QString contribution))  // my mouse-draw randomness → folded into the seal
    SLOT(QString submitGuess(int guess))               // broadcast a guess; host proves + broadcasts the verdict
    SLOT(QString settleOnLez())                        // winner: settle the win on-zone (real STARK, background)
    // ── TOK pot (EPIC D) ──
    SLOT(QString setBet(int amount))                   // host, pre-start: set the room's stake size (0 = free)
    SLOT(QString fundOnZone())                         // any player: create + faucet-fund my on-zone pot account
    SLOT(QString placeBet())                           // player: stake betAmount into the pot
    SLOT(QString refundOnLez())                        // reclaim my stake if the game abandoned
    SLOT(QString leaveRoom())
}
