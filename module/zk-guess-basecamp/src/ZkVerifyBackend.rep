class ZkVerifyBackend
{
    PROP(QString lastJson READONLY)

    // name: "valid" | "tampered" (bundled fixtures), or an absolute receipt path.
    // Runs the bundled `zk-verify` tool (zk-guess) and reports the turn verdict.
    SLOT(void verifyReceipt(QString name))

    // live game: submit a guess to the host (ZK_GAME_DIR); async — the host proves,
    // we verify client-side, then verifyResult fires. UI shows "proving…" meanwhile.
    SLOT(void submitGuess(int guess))

    // dir: 0 below · 1 equal · 2 above  (the guess relative to the sealed secret)
    SIGNAL(verifyResult(bool valid, QString commitment, int guess, int dir, QString error))
}
